{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nooma",
  "mainBinaryName": "nooma-app",
  "identifier": "com.lacodda.nooma",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nooma",
        "width": 1000,
        "height": 680,
        "minWidth": 560,
        "minHeight": 360,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Local search over your files, fully offline",
    "longDescription": "nooma searches the folders you give it - notes, text, an Obsidian vault - and never sends a byte of them anywhere."
  }
}
